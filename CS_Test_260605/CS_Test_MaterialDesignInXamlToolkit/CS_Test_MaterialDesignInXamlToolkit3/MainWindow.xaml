<Window x:Class="CS_Test_MaterialDesignInXamlToolkit3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Smart Order Kiosk"
        Width="1500"
        Height="1000"
        WindowStartupLocation="CenterScreen"
        FontFamily="Malgun Gothic"
        Background="#F5F5F7">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- 왼쪽 사이드 메뉴 -->
        <Border Grid.Column="0"
                Background="#2D1B69"
                Padding="22">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="FAST"
                               Foreground="White"
                               FontSize="34"
                               FontWeight="Black"/>

                    <TextBlock Text="KIOSK"
                               Foreground="#FFD54F"
                               FontSize="34"
                               FontWeight="Black"
                               Margin="0,-8,0,0"/>

                    <TextBlock Text="Material Design 주문 시스템"
                               Foreground="#D1C4E9"
                               FontSize="13"
                               Margin="0,14,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center">

                    <Button Content="전체 메뉴"
                            Tag="전체"
                            Click="CategoryButton_Click"
                            Height="52"
                            Margin="0,7"
                            FontSize="16"
                            Foreground="White"
                            Background="#512DA8"
                            BorderThickness="0"/>

                    <Button Content="버거"
                            Tag="버거"
                            Click="CategoryButton_Click"
                            Height="52"
                            Margin="0,7"
                            FontSize="16"
                            Foreground="White"
                            Background="#4527A0"
                            BorderThickness="0"/>

                    <Button Content="사이드"
                            Tag="사이드"
                            Click="CategoryButton_Click"
                            Height="52"
                            Margin="0,7"
                            FontSize="16"
                            Foreground="White"
                            Background="#4527A0"
                            BorderThickness="0"/>

                    <Button Content="음료"
                            Tag="음료"
                            Click="CategoryButton_Click"
                            Height="52"
                            Margin="0,7"
                            FontSize="16"
                            Foreground="White"
                            Background="#4527A0"
                            BorderThickness="0"/>

                    <Button Content="디저트"
                            Tag="디저트"
                            Click="CategoryButton_Click"
                            Height="52"
                            Margin="0,7"
                            FontSize="16"
                            Foreground="White"
                            Background="#4527A0"
                            BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 가운데 메뉴 영역 -->
        <Grid Grid.Column="1"
              Margin="28">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock x:Name="CategoryTitleText"
                           Text="전체 메뉴"
                           FontSize="34"
                           FontWeight="Black"
                           Foreground="#222"/>

                <TextBlock Text="원하는 메뉴를 선택하면 오른쪽 장바구니에 추가됩니다."
                           Foreground="#777"
                           FontSize="14"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1"
                          Margin="0,24,0,0"
                          VerticalScrollBarVisibility="Auto">

                <ItemsControl x:Name="MenuItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Tag="{Binding}"
                                    Click="AddMenuButton_Click"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Margin="8"
                                    Width="250"
                                    Height="285"
                                    Cursor="Hand"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch">

                                <materialDesign:Card Width="240"
                                                     Height="275"
                                                     Padding="18"
                                                     UniformCornerRadius="22"
                                                     Background="White">

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <DockPanel Grid.Row="0">
                                            <Border DockPanel.Dock="Left"
                                                    Width="54"
                                                    Height="54"
                                                    CornerRadius="18"
                                                    Background="#EDE7F6">
                                                <TextBlock Text="{Binding Icon}"
                                                           FontSize="28"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>

                                            <Border DockPanel.Dock="Right"
                                                    Background="#F3E5F5"
                                                    CornerRadius="12"
                                                    Padding="8,4"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Category}"
                                                           Foreground="#512DA8"
                                                           FontSize="12"
                                                           FontWeight="Bold"/>
                                            </Border>
                                        </DockPanel>

                                        <StackPanel Grid.Row="1"
                                                    Margin="0,16,0,0">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       Foreground="#222"
                                                       TextWrapping="Wrap"/>

                                            <TextBlock Text="{Binding Description}"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="#777"
                                                       FontSize="13"
                                                       Margin="0,8,0,0"
                                                       MaxHeight="44"/>
                                        </StackPanel>

                                        <DockPanel Grid.Row="2"
                                                   LastChildFill="False"
                                                   Margin="0,10,0,0">

                                            <TextBlock Text="{Binding Price, StringFormat=₩ {0:N0}}"
                                                       FontSize="20"
                                                       FontWeight="Black"
                                                       Foreground="#311B92"
                                                       DockPanel.Dock="Left"
                                                       VerticalAlignment="Center"/>

                                            <Border DockPanel.Dock="Right"
                                                    Background="#512DA8"
                                                    CornerRadius="14"
                                                    Padding="10,6"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="담기"
                                                           Foreground="White"
                                                           FontSize="13"
                                                           FontWeight="Bold"/>
                                            </Border>
                                        </DockPanel>
                                    </Grid>
                                </materialDesign:Card>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- 오른쪽 장바구니 -->
        <Border Grid.Column="2"
                Background="White"
                Padding="24">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="장바구니"
                                   FontSize="28"
                                   FontWeight="Black"
                                   Foreground="#222"/>

                        <TextBlock x:Name="CountText"
                                   Text="0개 선택됨"
                                   Foreground="#777"
                                   FontSize="14"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button DockPanel.Dock="Right"
                            Content="초기화"
                            Click="ClearCartButton_Click"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            VerticalAlignment="Center"/>
                </DockPanel>

                <Grid Grid.Row="1"
                      Margin="0,24,0,24">

                    <TextBlock x:Name="EmptyCartText"
                               Text="아직 선택한 메뉴가 없습니다."
                               Foreground="#999"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="CartItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F7F7FA"
                                            CornerRadius="18"
                                            Padding="14"
                                            Margin="0,0,0,12">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="{Binding Product.Name}"
                                                           FontSize="15"
                                                           FontWeight="Bold"
                                                           Foreground="#222"/>

                                                <DockPanel Margin="0,6,0,0">
                                                    <TextBlock Text="1개 가격"
                                                               FontSize="13"
                                                               Foreground="#777"/>

                                                    <TextBlock Text="{Binding Product.Price, StringFormat=₩ {0:N0}}"
                                                               DockPanel.Dock="Right"
                                                               FontSize="13"
                                                               FontWeight="Bold"
                                                               Foreground="#555"/>
                                                </DockPanel>

                                                <DockPanel Margin="0,4,0,0">
                                                    <TextBlock Text="메뉴 합계"
                                                               FontSize="14"
                                                               FontWeight="Bold"
                                                               Foreground="#512DA8"/>

                                                    <TextBlock Text="{Binding LineTotal, StringFormat=₩ {0:N0}}"
                                                               DockPanel.Dock="Right"
                                                               FontSize="15"
                                                               FontWeight="Black"
                                                               Foreground="#512DA8"/>
                                                </DockPanel>

                                                <StackPanel Orientation="Horizontal"
                                                            Margin="0,12,0,0">

                                                    <Button Width="36"
                                                            Height="36"
                                                            Tag="{Binding}"
                                                            Click="DecreaseButton_Click"
                                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                                            Padding="0"
                                                            FontSize="20"
                                                            FontWeight="Bold"
                                                            Foreground="#512DA8">
                                                        <TextBlock Text="−"
                                                                   FontSize="22"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   TextAlignment="Center"/>
                                                    </Button>

                                                    <TextBlock Text="{Binding Quantity}"
                                                               Width="42"
                                                               TextAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="16"
                                                               FontWeight="Bold"/>

                                                    <Button Width="36"
                                                            Height="36"
                                                            Tag="{Binding}"
                                                            Click="IncreaseButton_Click"
                                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                                            Padding="0"
                                                            FontSize="20"
                                                            FontWeight="Bold"
                                                            Foreground="#512DA8">
                                                        <TextBlock Text="+"
                                                                   FontSize="22"
                                                                   FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   TextAlignment="Center"/>
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Content="삭제"
                                                    Tag="{Binding}"
                                                    Click="RemoveCartButton_Click"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    Foreground="#D32F2F"
                                                    VerticalAlignment="Top"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <StackPanel Grid.Row="2">
                    <Border Background="#F7F7FA"
                            CornerRadius="20"
                            Padding="18">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="상품 금액"
                                           Foreground="#666"
                                           FontSize="15"/>
                                <TextBlock x:Name="SubTotalText"
                                           Text="₩ 0"
                                           DockPanel.Dock="Right"
                                           FontSize="15"
                                           FontWeight="Bold"/>
                            </DockPanel>

                            <Separator Margin="0,8"/>

                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="총 결제 금액"
                                           FontSize="18"
                                           FontWeight="Black"
                                           Foreground="#222"/>
                                <TextBlock x:Name="TotalText"
                                           Text="₩ 0"
                                           DockPanel.Dock="Right"
                                           FontSize="24"
                                           FontWeight="Black"
                                           Foreground="#311B92"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Button Content="결제하기"
                            Height="58"
                            Margin="0,18,0,0"
                            FontSize="18"
                            FontWeight="Bold"
                            Click="PaymentButton_Click"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#512DA8"
                            Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 결제 팝업 -->
        <Grid x:Name="PaymentOverlay"
              Grid.ColumnSpan="3"
              Background="#99000000"
              Visibility="Collapsed">

            <materialDesign:Card Width="480"
                                 Padding="32"
                                 UniformCornerRadius="28"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Background="White">

                <StackPanel>
                    <TextBlock Text="주문 확인"
                               FontSize="30"
                               FontWeight="Black"
                               Foreground="#222"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="아래 금액으로 결제를 진행할까요?"
                               FontSize="15"
                               Foreground="#777"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,24"/>

                    <Border Background="#F3E5F5"
                            CornerRadius="22"
                            Padding="22"
                            Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="총 결제 금액"
                                       Foreground="#512DA8"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       HorizontalAlignment="Center"/>

                            <TextBlock x:Name="PaymentTotalText"
                                       Text="₩ 0"
                                       Foreground="#311B92"
                                       FontWeight="Black"
                                       FontSize="38"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button Content="카드 결제 완료"
                            Height="56"
                            FontSize="17"
                            FontWeight="Bold"
                            Click="CompletePaymentButton_Click"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#512DA8"
                            Foreground="White"/>

                    <Button Content="취소"
                            Height="48"
                            Margin="0,10,0,0"
                            Click="CancelPaymentButton_Click"
                            Style="{StaticResource MaterialDesignFlatButton}"/>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Window>