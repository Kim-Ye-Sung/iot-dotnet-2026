<Window x:Class="CS_Test_MaterialDesignInXamlToolkit2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Material Design WPF"
        Height="650"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 왼쪽 메뉴 영역 -->
        <Border Grid.Column="0"
                Background="{DynamicResource PrimaryHueMidBrush}">
            <StackPanel Margin="20">

                <TextBlock Text="My WPF App"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"
                           Margin="0 20 0 40"/>

                <Button Content="Dashboard"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="White"
                        HorizontalContentAlignment="Left"
                        Margin="0 5"/>

                <Button Content="Users"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="White"
                        HorizontalContentAlignment="Left"
                        Margin="0 5"/>

                <Button Content="Settings"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="White"
                        HorizontalContentAlignment="Left"
                        Margin="0 5"/>

            </StackPanel>
        </Border>

        <!-- 오른쪽 메인 영역 -->
        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="150"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Dashboard"
                       FontSize="32"
                       FontWeight="Bold"
                       Margin="0 0 0 20"/>

            <!-- 카드 영역 -->
            <UniformGrid Grid.Row="1" Columns="3" Margin="0 0 0 20">

                <materialDesign:Card Padding="20" Margin="8">
                    <StackPanel>
                        <TextBlock Text="Total Users"
                                   FontSize="16"/>
                        <TextBlock Text="128"
                                   FontSize="36"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Padding="20" Margin="8">
                    <StackPanel>
                        <TextBlock Text="New Orders"
                                   FontSize="16"/>
                        <TextBlock Text="32"
                                   FontSize="36"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Padding="20" Margin="8">
                    <StackPanel>
                        <TextBlock Text="Messages"
                                   FontSize="16"/>
                        <TextBlock Text="15"
                                   FontSize="36"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </materialDesign:Card>

            </UniformGrid>

            <!-- 입력 폼 -->
            <materialDesign:Card Grid.Row="2"
                                 Padding="20"
                                 Margin="0 0 0 20">
                <StackPanel>
                    <TextBlock Text="User Information"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0 0 0 15"/>

                    <TextBox materialDesign:HintAssist.Hint="Name"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0 0 0 10"/>

                    <TextBox materialDesign:HintAssist.Hint="Email"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0 0 0 10"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="SAVE"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Margin="5"/>

                        <Button Content="CANCEL"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="5"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- 목록 영역 -->
            <DataGrid Grid.Row="3"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      Style="{StaticResource MaterialDesignDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="100"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

        </Grid>
    </Grid>
</Window>